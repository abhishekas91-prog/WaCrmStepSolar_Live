# Copy this file to deploy/.env and fill in the values.
# Used by deploy/deploy.sh -> docker compose (build args + runtime env).

# --- required ---------------------------------------------------------
# Atlas connection string (full URI including credentials). Use the same
# cluster as the StepSolar backend so all business data lives in one DB:
#   mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/?appName=...
MONGO_URL=

# JWT secret for session tokens (HS256). Any long random string:
#   openssl rand -base64 32
JWT_SECRET=

# WhatsApp token encryption (64 hex chars = 32 bytes, AES-256-GCM).
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating this orphans every token encrypted under the previous key.
ENCRYPTION_KEY=

# Meta App Secret (Meta for Developers -> App Settings -> Basic). Verifies
# the HMAC on every inbound webhook POST. Required for the webhook.
META_APP_SECRET=

# Canonical public URL (build-time; inlined into the client bundle).
NEXT_PUBLIC_SITE_URL=https://whatsapp.stepsolar.in

# --- recommended ------------------------------------------------------
# Create/ensure the CRM indexes on server boot (idempotent, safe to leave
# on). Equivalent to: node frontend/scripts/seed-mongo.mjs
SEED_INDEXES_ON_START=1

# MongoDB database name (default: stepsolar).
DB_NAME=stepsolar

# Default locale for the UI.
NEXT_PUBLIC_APP_LOCALE=en

# Shared secret protecting GET /api/automations/cron. Required if you use
# Wait steps in automations. Generate: openssl rand -hex 32
# AUTOMATION_CRON_SECRET=

# Meta App ID — needed only for image-header message templates.
# META_APP_ID=
